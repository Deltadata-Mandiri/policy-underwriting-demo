# Copy this file to `.env` and fill in your Orkes Conductor credentials.
# These stay SERVER-SIDE — the browser never sees them.

CONDUCTOR_SERVER_URL=https://<your-tenant>.orkesconductor.io/api

# Create an Application key/secret in Orkes: Access Control -> Applications.
CONDUCTOR_AUTH_KEY=your-application-key-id
CONDUCTOR_AUTH_SECRET=your-application-secret

# Workflow this console drives (defaults shown)
WORKFLOW_NAME=policy_underwriting
WORKFLOW_VERSION=1
REVIEW_TASK_REF=underwriter_review_ref

# Local proxy port
PORT=4300
